{
  "version": 3,
  "configurePresets": [
    {"name": "windows", "generator": "Visual Studio 17 2022", "architecture": "x64", "binaryDir": "${sourceDir}/build", "cacheVariables": {"CUDARL_ENABLE_CUDA": "ON"}},
    {"name": "cpu", "inherits": "windows", "binaryDir": "${sourceDir}/build/cpu", "cacheVariables": {"CUDARL_ENABLE_CUDA": "OFF", "CUDARL_BUILD_GODOT": "OFF"}}
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "windows", "configuration": "Release"},
    {"name": "cpu", "configurePreset": "cpu", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "release", "configurePreset": "windows", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "cpu", "configurePreset": "cpu", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}

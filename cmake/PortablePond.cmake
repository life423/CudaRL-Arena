enable_testing()
if(WIN32)
    add_executable(CudaRLPond WIN32 tools/pond_launcher.cpp)
    cudarl_strict_warnings(CudaRLPond)
endif()
add_executable(pond_player_bench tools/pond_player_bench.cpp)
target_link_libraries(pond_player_bench PRIVATE cudarl_runtime)
target_compile_definitions(pond_player_bench PRIVATE CUDARL_WITH_CUDA=0)
cudarl_strict_warnings(pond_player_bench)
add_executable(cudarl_portable_tests tests/test_portable_pond.cpp)
target_link_libraries(cudarl_portable_tests PRIVATE cudarl_runtime)
target_compile_definitions(cudarl_portable_tests PRIVATE CUDARL_WITH_CUDA=0)
cudarl_strict_warnings(cudarl_portable_tests)
add_test(NAME portable_pond COMMAND cudarl_portable_tests "${CMAKE_SOURCE_DIR}/godot-project/pond/policies/deep_selector.bin" "${CMAKE_SOURCE_DIR}/tests/fixtures/pond_cpu_reference.csv")
if(CUDARL_BUILD_GODOT)
    set(CUDARL_GODOT_CPP_LIBRARY "${CMAKE_SOURCE_DIR}/external/godot-cpp/bin/libgodot-cpp.windows.template_release.x86_64.lib" CACHE FILEPATH "Platform-specific prebuilt godot-cpp library")
    if(NOT EXISTS "${CUDARL_GODOT_CPP_LIBRARY}")
        message(FATAL_ERROR "Build godot-cpp for this platform or use -DCUDARL_BUILD_GODOT=OFF")
    endif()
    add_library(portable_godot_cpp STATIC IMPORTED)
    set_target_properties(portable_godot_cpp PROPERTIES IMPORTED_LOCATION "${CUDARL_GODOT_CPP_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/external/godot-cpp/include;${CMAKE_SOURCE_DIR}/external/godot-cpp/gen/include;${CMAKE_SOURCE_DIR}/external/godot-cpp/gdextension"
        INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/external/godot-cpp/include;${CMAKE_SOURCE_DIR}/external/godot-cpp/gen/include;${CMAKE_SOURCE_DIR}/external/godot-cpp/gdextension")
    add_library(cudarl SHARED src/godot/register_types.cpp src/godot/deep_pond_lab.cpp)
    target_link_libraries(cudarl PRIVATE cudarl_runtime portable_godot_cpp)
    target_compile_definitions(cudarl PRIVATE CUDARL_WITH_CUDA=0 TYPED_METHOD_BIND $<$<PLATFORM_ID:Windows>:WINDOWS_ENABLED>)
    cudarl_strict_warnings(cudarl)
    set(CUDARL_PORTABLE_PLAYER "${CMAKE_BINARY_DIR}/player" CACHE PATH "Staged portable pond project")
    set_target_properties(cudarl PROPERTIES PREFIX "" RUNTIME_OUTPUT_DIRECTORY_RELEASE "${CUDARL_PORTABLE_PLAYER}/addons/cudarl/bin"
        LIBRARY_OUTPUT_DIRECTORY_RELEASE "${CUDARL_PORTABLE_PLAYER}/addons/cudarl/bin")
endif()
